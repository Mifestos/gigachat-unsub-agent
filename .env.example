# GigaChat API (получить на developers.sber.ru -> GigaChat API -> Получить ключ)
GIGACHAT_CREDENTIALS=your_base64_auth_key_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL=False

# MLOps & Cache
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=604800

# Model Artifacts
MODEL_PATH=models/subscription_catboost.cbm
MODEL_CONFIG_PATH=models/model_config.json

# A/B Experiment Config
AB_TRAFFIC_SPLIT=0.5
